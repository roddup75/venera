// Create these measures after importing the CSV files.
Selected AUM = SELECTEDVALUE(Scenarios[AUM_USD_bn], 3.4)
Selected Model = SELECTEDVALUE(Scenarios[Model], "ADV calibrated")
Net IR = MAX(Scenarios[Net_IR])
Net Alpha = MAX(Scenarios[Net_alpha_pct])
Implemented Alpha = MAX(Scenarios[Implemented_alpha_pct])
Alpha Capture = MAX(Scenarios[Alpha_capture_pct])
Impact = MAX(Scenarios[Impact_bp])
Average Days = MAX(Scenarios[Average_days])
Three Plus Days = MAX(Scenarios[Three_plus_days_pct])
Retained Alpha = MAX(Scenarios[Retained_alpha_pct])
Unfinished Notional = MAX(Scenarios[Unfinished_notional_pct])
Minimum IR = 0.4
IR Status = IF([Net IR] >= [Minimum IR], "Above threshold", "Below threshold")
IR Capacity =
VAR Threshold = [Minimum IR]
VAR ModelName = [Selected Model]
RETURN MINX(FILTER(ALL(Scenarios), Scenarios[Model] = ModelName && Scenarios[Net_IR] <= Threshold), Scenarios[AUM_USD_bn])
